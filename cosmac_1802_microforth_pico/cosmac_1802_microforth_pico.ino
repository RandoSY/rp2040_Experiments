#include <Arduino.h>
#include "cdp1802.h"
#include "native_kernel_v2.h"

// COSMAC 1802 microFORTH Native Bench for Raspberry Pi Pico / RP2040.
// No Galileo flight-control software is present in this image.
// The native kernel is an independent microFORTH-lineage teaching reconstruction,
// not a byte-for-byte redistribution of FORTH, Inc.'s commercial 1978 ROM.

namespace {
constexpr uint16_t MF_DICT_START=0x8000, MF_DICT_LIMIT=0xBFF0;
constexpr uint16_t MF_THREAD=0xD000, MF_STACK_TOP=0xE000, MF_RSTACK_TOP=0xF000;
constexpr uint16_t MF_DATA_START=0x7000, MF_DATA_LIMIT=0x7F00;

class BenchBus: public CDP1802Bus {
public:
  uint8_t memory[65536]{};
  uint8_t outputLatch[8]{};
  uint16_t adc[2]{512,256};
  uint8_t switches=0,adcSelect=0;
  uint8_t read(uint16_t a) override{return memory[a];}
  void write(uint16_t a,uint8_t v) override{if(a>=MF_KERNEL_START&&a<MF_KERNEL_END)return;memory[a]=v;}
  uint8_t input(uint8_t p) override{p&=7;if(p==1)return switches;uint16_t v=adc[adcSelect&1]&0x3ff;if(p==2)return(uint8_t)v;if(p==3)return(uint8_t)(v>>8);return 0;}
  void output(uint8_t p,uint8_t v) override{p&=7;outputLatch[p]=v;if(p==2)adcSelect=v&1;}
  void qChanged(bool q) override{qLevel_=q;if(qReady_)digitalWrite(LED_BUILTIN,q?HIGH:LOW);}
  void beginQ(){pinMode(LED_BUILTIN,OUTPUT);qReady_=true;digitalWrite(LED_BUILTIN,qLevel_?HIGH:LOW);}
  void raw(uint16_t a,uint8_t v){memory[a]=v;}
  static int hn(char c){if(c>='0'&&c<='9')return c-'0';if(c>='A'&&c<='F')return c-'A'+10;if(c>='a'&&c<='f')return c-'a'+10;return 0;}
  void installKernel(){for(uint16_t i=0;i<MF_KERNEL_SIZE;i++)memory[MF_KERNEL_START+i]=(uint8_t)((hn(MF_KERNEL_HEX[i*2])<<4)|hn(MF_KERNEL_HEX[i*2+1]));}
private: bool qReady_=false,qLevel_=false;
};
BenchBus bus; CDP1802 cpu(bus);
bool running=false,forthMode=true; uint32_t cpuHz=1600000,lastTickUs=0; int64_t clockBudget=0;
char linebuf[384];size_t linelen=0;
char up(char c){return(c>='a'&&c<='z')?(char)(c-'a'+'A'):c;}
bool ieq(const char*a,const char*b){if(!a||!b)return false;while(*a&&*b)if(up(*a++)!=up(*b++))return false;return *a==0&&*b==0;}
int nib(char c){if(c>='0'&&c<='9')return c-'0';c=up(c);return(c>='A'&&c<='F')?c-'A'+10:-1;}
bool phex(const char*s,uint32_t max,uint32_t&v){if(!s||!*s)return false;if(*s=='$')s++;else if(s[0]=='0'&&(s[1]=='x'||s[1]=='X'))s+=2;if(!*s)return false;char*e=nullptr;unsigned long x=strtoul(s,&e,16);if(!e||*e||x>max)return false;v=x;return true;}
bool puint(const char*s,uint32_t lo,uint32_t hi,uint32_t&v){if(!s||!*s)return false;char*e=nullptr;unsigned long x=strtoul(s,&e,0);if(!e||*e||x<lo||x>hi)return false;v=x;return true;}
void h2(Stream&io,uint8_t v){const char*d="0123456789ABCDEF";io.print(d[v>>4]);io.print(d[v&15]);}
void h4(Stream&io,uint16_t v){h2(io,v>>8);h2(io,v);}
void h8(Stream&io,uint32_t v){h4(io,v>>16);h4(io,v);}
void h16(Stream&io,uint64_t v){h8(io,v>>32);h8(io,v);}
void stopRun(){running=false;clockBudget=0;}void startRun(){running=true;lastTickUs=micros();clockBudget=0;}
void state(){Serial.print("@1802 STATE ");for(int i=0;i<16;i++){Serial.print('R');Serial.print("0123456789ABCDEF"[i]);Serial.print('=');h4(Serial,cpu.R[i]);Serial.print(' ');}Serial.print("D=");h2(Serial,cpu.D);Serial.print(" DF=");Serial.print(cpu.DF);Serial.print(" P=");Serial.print(cpu.P,HEX);Serial.print(" X=");Serial.print(cpu.X,HEX);Serial.print(" T=");h2(Serial,cpu.T);Serial.print(" IE=");Serial.print(cpu.IE);Serial.print(" Q=");Serial.print(cpu.Q);Serial.print(" PC=");h4(Serial,cpu.pc());Serial.print(" IDL=");Serial.print(cpu.idle);Serial.print(" HALT=");Serial.print(cpu.halted);Serial.print(" RUN=");Serial.print(running);Serial.print(" INS=");h16(Serial,cpu.instructions);Serial.print(" CYC=");h16(Serial,cpu.machineCycles);Serial.print(" HZ=");Serial.println(cpuHz);}
void ioState(){Serial.print("@1802 IO SW=");h2(Serial,bus.switches);Serial.print(" ADC0=");h4(Serial,bus.adc[0]&0x3ff);Serial.print(" ADC1=");h4(Serial,bus.adc[1]&0x3ff);Serial.print(" SEL=");Serial.print(bus.adcSelect);Serial.print(" OUT1=");h2(Serial,bus.outputLatch[1]);Serial.print(" OUT2=");h2(Serial,bus.outputLatch[2]);Serial.println();}
void err(const char*s){Serial.print("@1802 ERR ");Serial.println(s);}

struct NW{const char*name;uint16_t cfa;};
const NW NWDS[]={{"+",MF_CFA_PLUS},{"-",MF_CFA_MINUS},{"*",MF_CFA_MUL},{"/",MF_CFA_DIV},{"AND",MF_CFA_AND},{"OR",MF_CFA_OR},{"XOR",MF_CFA_XOR},{"DUP",MF_CFA_DUP},{"DROP",MF_CFA_DROP},{"OVER",MF_CFA_OVER},{"SWAP",MF_CFA_SWAP},{"ROT",MF_CFA_ROT},{"@",MF_CFA_AT},{"!",MF_CFA_STORE},{"+!",MF_CFA_PLUSSTORE},{"0=",MF_CFA_ZEROEQ},{"0<",MF_CFA_ZEROLESS},{"=",MF_CFA_EQ},{"<>",MF_CFA_NE},{"<",MF_CFA_LESS},{">",MF_CFA_GREATER},{"1+",MF_CFA_ONEPLUS},{"2+",MF_CFA_TWOPLUS},{"QON",MF_CFA_QON},{"QOFF",MF_CFA_QOFF},{"OUT1",MF_CFA_OUT1},{"OUT2",MF_CFA_OUT2},{"IN1",MF_CFA_IN1},{"IN2",MF_CFA_IN2},{"IN3",MF_CFA_IN3}};
constexpr size_t NWC=sizeof(NWDS)/sizeof(NWDS[0]);
const NW*fnw(const char*n){for(size_t i=0;i<NWC;i++)if(ieq(n,NWDS[i].name))return&NWDS[i];return nullptr;}
enum class DK:uint8_t{EMPTY,COLON,CONSTANT,VARIABLE};struct FD{char name[18]{};DK kind=DK::EMPTY;uint16_t value=0;};FD defs[64];
uint16_t dictHere=MF_DICT_START,dataHere=MF_DATA_START,fs[128];size_t fd=0;int fbase=10;
FD*fdef(const char*n){for(auto&d:defs)if(d.kind!=DK::EMPTY&&ieq(n,d.name))return&d;return nullptr;}
FD*adef(const char*n){if(FD*d=fdef(n))return d;for(auto&d:defs)if(d.kind==DK::EMPTY){strncpy(d.name,n,sizeof(d.name)-1);return&d;}return nullptr;}
bool push(uint16_t v){if(fd>=128){Serial.print(" ? STACK OVERFLOW");return false;}fs[fd++]=v;return true;}bool pop(uint16_t&v){if(!fd){Serial.print(" ? STACK EMPTY");return false;}v=fs[--fd];return true;}
bool fnum(const char*t,uint16_t&v){if(!t||!*t)return false;const char*p=t;bool neg=false;if(*p=='-'){neg=true;p++;}int b=fbase;if(*p=='$'){b=16;p++;}else if(p[0]=='0'&&(p[1]=='x'||p[1]=='X')){b=16;p+=2;}if(!*p)return false;uint32_t n=0;for(;*p;p++){int d=(*p>='0'&&*p<='9')?*p-'0':(up(*p)>='A'&&up(*p)<='Z'?up(*p)-'A'+10:-1);if(d<0||d>=b)return false;n=n*b+d;}v=(uint16_t)(neg?-(int32_t)n:n);return true;}
void word(uint16_t a,uint16_t v){bus.raw(a,v>>8);bus.raw(a+1,v);}
uint16_t pack(){uint16_t sp=MF_STACK_TOP;for(size_t i=0;i<fd;i++){uint16_t v=fs[i];bus.raw(--sp,v);bus.raw(--sp,v>>8);}return sp;}
bool unpack(uint16_t sp){uint16_t nb=MF_STACK_TOP-sp;if(nb&1)return false;size_t n=nb/2;if(n>128)return false;uint16_t tmp[128];for(size_t i=0;i<n;i++){uint16_t a=sp+i*2;tmp[i]=(bus.read(a)<<8)|bus.read(a+1);}fd=n;for(size_t i=0;i<n;i++)fs[i]=tmp[n-1-i];return true;}
bool native(uint16_t cfa,const char*name){if(ieq(name,"/")&&fd&&fs[fd-1]==0){Serial.print(" ? DIVIDE BY ZERO");return false;}stopRun();uint8_t q=cpu.Q;CDP1802State s{};s.Q=q;s.IE=1;cpu.restore(s);uint16_t sp=pack();word(MF_THREAD,cfa);word(MF_THREAD+2,MF_CFA_STOP);cpu.R[14]=sp;cpu.R[13]=MF_THREAD;cpu.R[15]=MF_NEXT;cpu.R[2]=MF_RSTACK_TOP;cpu.P=15;cpu.X=0;uint32_t n=0;while(!cpu.idle&&!cpu.halted&&n<2000000){CDP1802Step r=cpu.step();if(!r.cycles&&!cpu.idle)break;n++;}if(!cpu.idle||cpu.halted){Serial.print(" ? NATIVE FAIL ");Serial.print(name);return false;}if(!unpack(cpu.R[14])){Serial.print(" ? STACK CORRUPTION");return false;}return true;}
bool cell(uint16_t v){if((uint32_t)dictHere+2>MF_DICT_LIMIT)return false;word(dictHere,v);dictHere+=2;return true;}bool lit(uint16_t v){return cell(MF_CFA_LIT)&&cell(v);}
bool ctok(const char*t){uint16_t n;if(fnum(t,n))return lit(n);if(const NW*w=fnw(t))return cell(w->cfa);if(FD*d=fdef(t)){if(d->kind==DK::COLON)return cell(d->value);if(d->kind==DK::CONSTANT||d->kind==DK::VARIABLE)return lit(d->value);}return false;}
bool colon(const char*n,char**t,size_t c){FD*d=adef(n);if(!d)return false;uint16_t save=dictHere,cfa=dictHere;if(!cell(MF_COLON_CODE)){dictHere=save;return false;}for(size_t i=0;i<c;i++)if(!ctok(t[i])){dictHere=save;return false;}if(!cell(MF_CFA_SEMIS)){dictHere=save;return false;}d->kind=DK::COLON;d->value=cfa;return true;}
void words(){Serial.println("+ - * / AND OR XOR DUP DROP OVER SWAP ROT @ ! +! 0= 0< = <> < > 1+ 2+");Serial.println("QON QOFF OUT1 OUT2 IN1 IN2 IN3  . U. .S HEX DECIMAL WORDS CR EMIT C@ C! MOD 1- 2* 2/ NEGATE ABS DEPTH");Serial.println("VARIABLE CONSTANT : ; MACHINE");for(auto&d:defs)if(d.kind!=DK::EMPTY){Serial.print(d.name);Serial.print(' ');}Serial.println();}
bool host(const char*t){uint16_t a,b;if(ieq(t,".")){if(!pop(a))return false;if(fbase==10)Serial.print((int16_t)a);else Serial.print(a,HEX);Serial.print(' ');return true;}if(ieq(t,"U.")){if(!pop(a))return false;if(fbase==10)Serial.print(a);else Serial.print(a,HEX);Serial.print(' ');return true;}if(ieq(t,".S")){Serial.print('<');Serial.print(fd);Serial.print("> ");for(size_t i=0;i<fd;i++){if(fbase==10)Serial.print((int16_t)fs[i]);else Serial.print(fs[i],HEX);Serial.print(' ');}return true;}if(ieq(t,"HEX")){fbase=16;return true;}if(ieq(t,"DECIMAL")){fbase=10;return true;}if(ieq(t,"WORDS")){words();return true;}if(ieq(t,"CR")){Serial.println();return true;}if(ieq(t,"EMIT")){if(!pop(a))return false;Serial.write((uint8_t)a);return true;}if(ieq(t,"C@")){if(!pop(a))return false;return push(bus.read(a));}if(ieq(t,"C!")){if(!pop(a)||!pop(b))return false;bus.write(a,b);return true;}if(ieq(t,"DEPTH"))return push(fd);if(ieq(t,"1-")){if(!pop(a))return false;return push(a-1);}if(ieq(t,"2*")){if(!pop(a))return false;return push(a<<1);}if(ieq(t,"2/")){if(!pop(a))return false;return push((uint16_t)((int16_t)a>>1));}if(ieq(t,"NEGATE")){if(!pop(a))return false;return push((uint16_t)(-(int16_t)a));}if(ieq(t,"ABS")){if(!pop(a))return false;int16_t x=(int16_t)a;return push((uint16_t)(x<0?-x:x));}if(ieq(t,"MOD")){if(!pop(b)||!pop(a))return false;if((int16_t)b==0){Serial.print(" ? DIVIDE BY ZERO");return false;}return push((uint16_t)((int16_t)a%(int16_t)b));}return false;}
bool xtok(const char*t){uint16_t n;if(fnum(t,n))return push(n);if(const NW*w=fnw(t))return native(w->cfa,w->name);if(FD*d=fdef(t)){if(d->kind==DK::COLON)return native(d->value,d->name);if(d->kind==DK::CONSTANT||d->kind==DK::VARIABLE)return push(d->value);}if(host(t))return true;Serial.print(" ? ");Serial.print(t);return false;}
void freset(bool announce){stopRun();for(auto&d:defs)d=FD{};fd=0;fbase=10;dictHere=MF_DICT_START;dataHere=MF_DATA_START;for(uint16_t a=MF_DATA_START;a<MF_DATA_LIMIT;a++)bus.raw(a,0);for(uint16_t a=MF_DICT_START;a<MF_DICT_LIMIT;a++)bus.raw(a,0);bus.installKernel();cpu.hardReset();cpu.setPC(MF_KERNEL_START);forthMode=true;if(announce){Serial.println();Serial.println("COSMAC 1802 microFORTH NATIVE BENCH");Serial.print("native kernel ROM $");h4(Serial,MF_KERNEL_START);Serial.print("-$");h4(Serial,MF_KERNEL_END-1);Serial.println("  independent educational reconstruction");Serial.println("2 3 + .");Serial.println(": SQUARE DUP * ;");Serial.println("12 SQUARE .");Serial.println("QON   QOFF   15 OUT1");Serial.println("OK");}}
void forth(char*l){if(char*s=strchr(l,'\\'))*s=0;char*tok[72];size_t n=0;for(char*t=strtok(l," \t");t&&n<72;t=strtok(nullptr," \t"))tok[n++]=t;if(!n)return;if(ieq(tok[0],"MACHINE")){forthMode=false;Serial.println("MACHINE MODE");return;}if(ieq(tok[0],":")){if(n<4||!ieq(tok[n-1],";")){Serial.println(" ? : expects NAME ... ;");return;}if(!colon(tok[1],&tok[2],n-3)){Serial.println(" ? CANNOT COMPILE");return;}Serial.println("OK");return;}for(size_t i=0;i<n;i++){if(ieq(tok[i],"VARIABLE")){if(++i>=n){Serial.println(" ? VARIABLE NEEDS NAME");return;}if(dataHere+2>MF_DATA_LIMIT){Serial.println(" ? DATA FULL");return;}FD*d=adef(tok[i]);if(!d){Serial.println(" ? DICTIONARY FULL");return;}d->kind=DK::VARIABLE;d->value=dataHere;bus.raw(dataHere,0);bus.raw(dataHere+1,0);dataHere+=2;continue;}if(ieq(tok[i],"CONSTANT")){if(++i>=n){Serial.println(" ? CONSTANT NEEDS NAME");return;}uint16_t v;if(!pop(v)){Serial.println();return;}FD*d=adef(tok[i]);if(!d){Serial.println(" ? DICTIONARY FULL");return;}d->kind=DK::CONSTANT;d->value=v;continue;}if(!xtok(tok[i])){Serial.println();return;}}Serial.println("OK");}

bool setreg(const char*n,uint32_t v){CDP1802State s=cpu.snapshot();if(n&&(n[0]=='R'||n[0]=='r')&&n[1]&&!n[2]){int r=nib(n[1]);if(r<0||v>0xffff)return false;s.R[r]=v;}else if(ieq(n,"D")){if(v>0xff)return false;s.D=v;}else if(ieq(n,"DF")){if(v>1)return false;s.DF=v;}else if(ieq(n,"P")){if(v>15)return false;s.P=v;}else if(ieq(n,"X")){if(v>15)return false;s.X=v;}else if(ieq(n,"T")){if(v>0xff)return false;s.T=v;}else if(ieq(n,"IE")){if(v>1)return false;s.IE=v;}else if(ieq(n,"Q")){if(v>1)return false;s.Q=v;}else return false;cpu.restore(s);return true;}
void help(){Serial.println("FORTH/@FORTH  MACHINE/@MACHINE");Serial.println("@RUN @STOP @STEP @RESET @STATE @SETPC @POKE @PEEK @SET @SPEED");Serial.println("@IO  @IOSET SW|ADC0|ADC1 value");}
void mon(char*l){char*c=strtok(l," \t");if(!c)return;if(ieq(c,"@HELP")){help();return;}if(ieq(c,"@STATE")){state();return;}if(ieq(c,"@IO")){ioState();return;}if(ieq(c,"@FORTH")){freset(true);return;}if(ieq(c,"@FORTHKEEP")){stopRun();forthMode=true;Serial.println("microFORTH terminal");Serial.println("OK");return;}if(ieq(c,"@MACHINE")){forthMode=false;stopRun();Serial.println("MACHINE MODE");return;}if(ieq(c,"@RUN")){forthMode=false;startRun();Serial.println("@1802 OK RUN");return;}if(ieq(c,"@STOP")){stopRun();Serial.println("@1802 OK STOP");return;}if(ieq(c,"@RESET")){stopRun();cpu.hardReset();Serial.println("@1802 OK RESET");state();return;}if(ieq(c,"@STEP")){forthMode=false;stopRun();CDP1802Step r=cpu.step();Serial.print("@1802 STEP PC=");h4(Serial,r.pc);Serial.print(" OP=");h2(Serial,r.opcode);Serial.print(" MC=");h2(Serial,r.cycles);Serial.println();state();return;}if(ieq(c,"@SETPC")){forthMode=false;stopRun();uint32_t v;if(!phex(strtok(nullptr," \t"),0xffff,v)){err("SETPC expects hex16");return;}cpu.setPC(v);Serial.print("@1802 OK SETPC=");h4(Serial,v);Serial.println();state();return;}if(ieq(c,"@POKE")){forthMode=false;stopRun();uint32_t a;if(!phex(strtok(nullptr," \t"),0xffff,a)){err("POKE expects address bytes");return;}uint8_t b[64];unsigned n=0;for(char*s=strtok(nullptr," \t");s;s=strtok(nullptr," \t")){uint32_t v;if(n>=64||!phex(s,0xff,v)){err("bad POKE byte");return;}b[n++]=v;}if(!n){err("POKE needs bytes");return;}for(unsigned i=0;i<n;i++)if((uint16_t)(a+i)>=MF_KERNEL_START&&(uint16_t)(a+i)<MF_KERNEL_END){err("POKE blocked: kernel ROM");return;}for(unsigned i=0;i<n;i++)bus.write((uint16_t)(a+i),b[i]);Serial.print("@1802 OK POKE ADDR=");h4(Serial,a);Serial.print(" COUNT=");h2(Serial,n);Serial.println();return;}if(ieq(c,"@PEEK")){uint32_t a,n=1;char*as=strtok(nullptr," \t"),*ns=strtok(nullptr," \t");if(!phex(as,0xffff,a)||(ns&&!phex(ns,0x40,n))||!n){err("PEEK expects address [count]");return;}Serial.print("@1802 MEM ADDR=");h4(Serial,a);Serial.print(" DATA=");for(uint32_t i=0;i<n;i++)h2(Serial,bus.read(a+i));Serial.println();return;}if(ieq(c,"@SET")){char*n=strtok(nullptr," \t"),*vs=strtok(nullptr," \t");uint32_t v;if(!n||!phex(vs,0xffff,v)||!setreg(n,v)){err("bad SET");return;}Serial.print("@1802 OK SET ");Serial.print(n);Serial.print('=');Serial.println(vs);state();return;}if(ieq(c,"@SPEED")){uint32_t v;if(!puint(strtok(nullptr," \t"),1000,32000000,v)){err("SPEED expects decimal Hz");return;}cpuHz=v;Serial.print("@1802 OK SPEED=");Serial.println(v);return;}if(ieq(c,"@IOSET")){char*w=strtok(nullptr," \t"),*vs=strtok(nullptr," \t");uint32_t v;if(!w||!vs){err("IOSET SW|ADC0|ADC1 value");return;}if(ieq(w,"SW")){if(!phex(vs,0xff,v)){err("bad SW");return;}bus.switches=v;}else if(ieq(w,"ADC0")||ieq(w,"ADC1")){if(!phex(vs,0x3ff,v)){err("bad ADC");return;}bus.adc[ieq(w,"ADC1")]=v;}else{err("IOSET SW|ADC0|ADC1");return;}ioState();return;}err("unknown command; @HELP");}
void line(char*l){while(*l==' '||*l=='\t')l++;if(!*l)return;if(*l=='@'){mon(l);return;}if(ieq(l,"FORTH")){freset(true);return;}if(ieq(l,"MACHINE")){forthMode=false;stopRun();Serial.println("MACHINE MODE");return;}if(forthMode){forth(l);return;}if(ieq(l,"RUN")){strcpy(l,"@RUN");mon(l);return;}if(ieq(l,"STOP")){strcpy(l,"@STOP");mon(l);return;}if(ieq(l,"STEP")){strcpy(l,"@STEP");mon(l);return;}if(ieq(l,"RESET")){strcpy(l,"@RESET");mon(l);return;}if(ieq(l,"STATE")){strcpy(l,"@STATE");mon(l);return;}if(ieq(l,"HELP")){help();return;}Serial.println("? MACHINE MODE: RUN STOP STEP RESET STATE FORTH");}
void tick(){if(!running||cpu.halted||cpu.idle)return;uint32_t now=micros(),dt=now-lastTickUs;lastTickUs=now;if(dt>50000)dt=50000;clockBudget+=(int64_t)dt*cpuHz;uint32_t g=0;while(clockBudget>=16000000LL&&!cpu.halted&&!cpu.idle&&g<100000){CDP1802Step r=cpu.step();if(!r.cycles)break;clockBudget-=(int64_t)r.cycles*8000000LL;g++;}if(cpu.halted||cpu.idle)running=false;}
}
void setup(){bus.beginQ();bus.installKernel();Serial.begin(115200);while(!Serial&&millis()<5000)delay(10);Serial.println("COSMAC 1802 / RP2040 microFORTH Native Bench");Serial.println("No Galileo flight software is present in this image.");Serial.println("Q -> Pico LED; simple IN1/IN2/IN3 and OUT1/OUT2 bench I/O.");freset(true);}
void loop(){tick();while(Serial.available()){int c=Serial.read();if(c<0)break;if(c=='\r')continue;if(c=='\n'){linebuf[linelen]=0;line(linebuf);linelen=0;}else if(linelen+1<sizeof(linebuf))linebuf[linelen++]=(char)c;else{linelen=0;Serial.println(" ? LINE TOO LONG");}}}
